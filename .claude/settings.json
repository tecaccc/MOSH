{
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "permissions": {
    "allow": [
      "Bash(python3 ./.trellis/scripts/task.py list)",
      "Bash(python3 ./.trellis/scripts/task.py --help)",
      "Bash(python3 ./.trellis/scripts/task.py create \"v1: 待办与日程\" --slug v1-todo-calendar)",
      "Bash(python3 ./.trellis/scripts/task.py create \"Todo 待办（含共享地基）\" --slug todo --parent .trellis/tasks/08-12-v1-todo-calendar)",
      "Bash(python3 ./.trellis/scripts/task.py create \"Calendar 日程\" --slug calendar --parent .trellis/tasks/08-12-v1-todo-calendar)",
      "Bash(find /data/workspace/MOSH/docs -maxdepth 2 -name '*.png' -newermt '-5 minutes' 2>/dev/null; ls -lat /tmp 2>/dev/null | head; echo \"---try pencil exports dir---\"; find / -maxdepth 4 -name '*.png' -newermt '-5 minutes' 2>/dev/null | grep -iv node_modules | head)",
      "Read(//tmp/**)",
      "Bash(file *.png)",
      "Bash(python3 -c ' *)",
      "Bash(rm -rf /tmp/mosh-verify)",
      "Bash(mkdir -p /tmp/mosh-verify)",
      "Bash(python3 ./.trellis/scripts/task.py current)",
      "Bash(rustc --version)",
      "Bash(cargo --version)",
      "Bash(npm --version)",
      "Bash(pnpm --version)",
      "Bash(bun --version)",
      "Bash(npx -y create-tauri-app@latest --help)",
      "Bash(rm -rf mosh-scaffold)",
      "Bash(npx -y create-tauri-app@latest mosh-scaffold -m npm -t svelte-ts --tauri-version 2 --identifier com.mosh.app -y)",
      "Bash(cd /data/workspace/MOSH *)",
      "Bash(sed -i 's/mosh-scaffold/mosh/g; s/mosh_scaffold_lib/mosh_lib/g' package.json src-tauri/Cargo.toml src-tauri/tauri.conf.json)",
      "Bash(sed -i 's/\"width\": 800/\"width\": 1440/; s/\"height\": 600/\"height\": 960/' src-tauri/tauri.conf.json)",
      "Bash(cargo build *)",
      "Bash(git add *)",
      "Bash(git commit -q -m 'scaffold: Tauri 2 + SvelteKit \\(SPA\\) + Cargo workspace with mosh-core *)",
      "Bash(python3 ./.trellis/scripts/task.py list --mine)",
      "Bash(python3 -c \"import json;d=json.load\\(open\\('.trellis/tasks/08-12-todo/task.json'\\)\\);print\\('status:',d['status']\\)\")",
      "Bash(cargo test *)",
      "Bash(python3 ./.trellis/scripts/task.py start --help)",
      "Bash(python3 ./.trellis/scripts/task.py list-context 08-12-todo)",
      "Bash(python3 ./.trellis/scripts/task.py start 08-12-todo)",
      "Bash(python3 -c \"import json;d=json.load\\(open\\('.trellis/tasks/08-12-todo/task.json'\\)\\);print\\('todo status:',d['status']\\)\")",
      "Bash(cargo clippy *)",
      "Bash(cargo check *)",
      "Bash(npx --no-install tauri --version)",
      "Bash(timeout 10 curl -sS -o /dev/null -w \"crates.io: %{http_code}\\\\n\" https://index.crates.io/config.json)",
      "Bash(timeout 10 curl -sS -o /dev/null -w \"registry.npmjs: %{http_code}\\\\n\" https://registry.npmjs.org/@tauri-apps%2fcli)",
      "Bash(npm install *)",
      "Bash(rustup target *)",
      "Bash(cargo install *)",
      "Bash(npm run *)",
      "Bash(node_modules/.bin/tauri build *)",
      "Bash(echo \"EXIT=$?\")",
      "Bash(echo \"=== target release 目录里所有 dll ===\"; ls -la target/x86_64-pc-windows-gnu/release/*.dll 2>/dev/null || echo \"release 目录无 .dll\"; echo \"=== deps 目录里的 dll ===\"; ls target/x86_64-pc-windows-gnu/release/deps/*.dll 2>/dev/null || echo \"deps 目录无 .dll\"; echo \"=== webview2-com-sys vendored dll 在哪 ===\"; find ~/.cargo/registry/src -path '*webview2-com-sys*' -name '*.dll' 2>/dev/null | head; echo \"=== 该 crate 目录树 ===\"; find ~/.cargo/registry/src -maxdepth 1 -type d -name 'webview2-com-sys-*' 2>/dev/null)",
      "Read(//root/.cargo/registry/src/**)",
      "Bash(rm -rf dist/windows)",
      "Bash(mkdir -p dist/windows)",
      "Bash(cp target/x86_64-pc-windows-gnu/release/mosh.exe dist/windows/)",
      "Bash(cp target/x86_64-pc-windows-gnu/release/WebView2Loader.dll dist/windows/)",
      "Bash(python3 -c \"import json;print\\('status:',json.load\\(open\\('.trellis/tasks/08-12-todo/task.json'\\)\\)['status']\\)\")",
      "Bash(git checkout *)",
      "Bash(python3 ./.trellis/scripts/task.py set-branch 08-12-todo feat/08-12-todo)",
      "WebFetch(domain:v2.tauri.app)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/session-start.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/session-start.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/session-start.py",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/inject-subagent-context.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/inject-subagent-context.py",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/inject-workflow-state.py",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "python3 .claude/hooks/statusline.py"
  },
  "enabledPlugins": {}
}
