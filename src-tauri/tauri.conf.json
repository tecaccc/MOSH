{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mosh",
  "version": "0.1.0",
  "identifier": "com.mosh.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "mosh",
        "width": 1440,
        "height": 960,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwMDkzNEY0Qjg1QzZBNzMKUldSemFseTQ5RFFKNE9HTjQ0WTdVZ1FwTjV4VVJvWGdkRFlrSE41dTRZWk5BRmZ6akJ4SzhLZlgK",
      "endpoints": [
        "https://github.com/tecaccc/MOSH/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
